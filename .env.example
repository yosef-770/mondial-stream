# סיסמת מקור ל-Icecast (שינוי בפרודקשן)
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_ADMIN_PASSWORD=change-me-admin

# ---------------------------------------------------------------------------
# זרמים לפי שלוחה (1–20)
# STREAM_N_URL ריק / חסר = השלוחה לא משדרת (relay במצב idle)
# STREAM_N_URLS = רשימת failover מופרדת בפסיקים (אופציונלי)
# ---------------------------------------------------------------------------

# שלוחה 1 / kanbet — רשת ב' (ברירת מחדל, עובד מרוב השרתים)
STREAM_1_URL=https://playerservices.streamtheworld.com/api/livestream-redirect/KAN_BET.mp3

# שלוחה 2 / kan11 — כאן 11 TV (דורש גישה ישראלית / proxy)
STREAM_2_URL=https://kancdn.medonecdn.net/livehls/oil/kancdn-live/live/kan11/live.livx/playlist.m3u8?bitrate=692000&audioId=1&videoId=16
STREAM_2_URLS=https://kancdn.medonecdn.net/livehls/oil/kancdn-live/live/kan11/live.livx/playlist.m3u8?bitrate=692000&audioId=1&videoId=16,https://r.il.cdn-redge.media/livehls/oil/kancdn-live/live/kan11/live.livx/playlist.m3u8?bitrate=692000&audioId=1&videoId=16

# Twitch: לא לשים playlist.ttvnw.net (פג תוך דקות). רק עמוד הערוץ:
# STREAM_5_URL=https://www.twitch.tv/CHANNEL
# STREAM_5_HTTP_PROXY=off
# X broadcasts/Spaces: STREAM_11_URL=https://x.com/i/broadcasts/ID

# שלוחות 3–20 — הוסף URL לפי הצורך
STREAM_3_URL=
STREAM_4_URL=
STREAM_5_URL=
STREAM_6_URL=
STREAM_7_URL=
STREAM_8_URL=
STREAM_9_URL=
STREAM_10_URL=
STREAM_11_URL=
STREAM_12_URL=
STREAM_13_URL=
STREAM_14_URL=
STREAM_15_URL=
STREAM_16_URL=
STREAM_17_URL=
STREAM_18_URL=
STREAM_19_URL=
