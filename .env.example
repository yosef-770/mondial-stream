# משותף / פר-שלוחה (אופציונלי)
STREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Proxy רק לשלוחות שחייבות (למשל כאן 11). לכל השאר: STREAM_N_HTTP_PROXY=off
# בלי off — השלוחה יורשת את STREAM_HTTP_PROXY הגלובלי (עומס + SPOF).
STREAM_HTTP_PROXY=http://188.191.147.40:8888
# STREAM_2 נשאר עם proxy (אל תשים off)
# STREAM_1_HTTP_PROXY=off
# STREAM_3_HTTP_PROXY=off
# STREAM_2_HEADERS_FILE=/kan11-headers.txt
# Backoff אחרי כשל מקור (אופציונלי): STREAM_RETRY_SLEEP_MIN=5 STREAM_RETRY_SLEEP_MAX=120

# FreeSWITCH
FS_EXTERNAL_IP=auto
FS_SIP_PORT=5060

# ימות המשיח → SIP (מלא כשמוכן)
YEMOT_SIP_USER=
YEMOT_SIP_PASSWORD=
YEMOT_SIP_REALM=
